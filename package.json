{
  "name": "thecinema",
  "version": "1.0.0",
  "type": "module",
  "description": "Daily pipeline to fetch movie theater data and store in Cloudflare D1",
  "main": "scripts/fetch-theaters.js",
  "scripts": {
    "dev": "npx -y wrangler dev",
    "deploy": "npx -y wrangler deploy",
    "fetch-theaters": "node scripts/fetch-theaters.js",
    "fetch-theaters:dry-run": "node scripts/fetch-theaters.js --dry-run",
    "db:migrate:local": "npx -y wrangler d1 migrations apply thecinema-db --local",
    "db:migrate:remote": "npx -y wrangler d1 migrations apply thecinema-db --remote",
    "dashboard:dev": "npm --prefix dashboard run dev",
    "dashboard:build": "npm --prefix dashboard run build",
    "test": "node scripts/verify-worker.js && node scripts/verify-pipeline.js"
  },
  "keywords": [
    "cinema",
    "movies",
    "philippines",
    "cloudflare-d1",
    "github-actions"
  ],
  "author": "",
  "license": "MIT"
}
